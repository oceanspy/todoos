# Todoos
compdef t=todoos

alias tu="todoos use"
alias tl="todoos -l"

ZSH_AUTOSUGGEST_HISTORY_IGNORE="todoos *|t *|ta *|tau *|tah *|tac *|tal *|tam *|tu *"
ZSH_AUTOSUGGEST_COMPLETION_IGNORE="todoos *|t *|ta *|tau *|tah *|tac *|tal *|tam *|tu *"

# Runs todoos, then syncs in the background. Returns todoos' exit code (not unison's),
# so that `todoos … && …` stops when a command fails.
_todoos_sync_run() {
    command todoos "$@"
    local rc=$?
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
    return $rc
}

todoos() {
    _todoos_sync_run "$@"
}

t() {
    _todoos_sync_run "$@"
}

ta() {
    _todoos_sync_run add "$@"
}
compdef _ta ta

tac() {
    _todoos_sync_run add -p critical "$@"
}
compdef _ta tac

tau() {
    _todoos_sync_run add -p urgent "$@"
}
compdef _ta tau

tah() {
    _todoos_sync_run add -p high "$@"
}
compdef _ta tah

tam() {
    _todoos_sync_run add -p medium "$@"
}
compdef _ta tam

tal() {
    _todoos_sync_run add -p low "$@"
}
compdef _ta tal

td() {
    _todoos_sync_run -l default "$@"
}

tda() {
    _todoos_sync_run -l default add "$@"
}
compdef _ta tda

tdac() {
    _todoos_sync_run -l default add -p critical "$@"
}
compdef _ta tdac

tdau() {
    _todoos_sync_run -l default add -p urgent "$@"
}
compdef _ta tdau

tdah() {
    _todoos_sync_run -l default add -p high "$@"
}
compdef _ta tdah

tdam() {
    _todoos_sync_run -l default add -p medium "$@"
}
compdef _ta tdam

tdal() {
    _todoos_sync_run -l default add -p low "$@"
}
compdef _ta tdal

_ta() {
  words=(todoos add "${words[@]:1}")
  ((CURRENT++))
  _todoos
}

_no_completion() {
  return 1
}

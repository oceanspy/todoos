# Todoos
compdef t=todoos

alias tu="todoos use"
alias tl="todoos -l"

ZSH_AUTOSUGGEST_HISTORY_IGNORE="todoos *|t *|ta *|tau *|tah *|tac *|tal *|tam *|tu *"
ZSH_AUTOSUGGEST_COMPLETION_IGNORE="todoos *|t *|ta *|tau *|tah *|tac *|tal *|tam *|tu *"

todoos() {
    command todoos "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}

t() {
    command todoos "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}

ta() {
    command todoos add "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _ta ta

tac() {
    command todoos add -p critical "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _ta tac

tau() {
    command todoos add -p urgent "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _ta tau

tah() {
    command todoos add -p high "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _ta tah

tam() {
    command todoos add -p medium "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _ta tam

tal() {
    command todoos add -p low "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _ta tal

td() {
    command todoos describe "$@"
    (unison -silent todoos-sync &>/dev/null &) &> /dev/null
}
compdef _td td

_ta() {
  words=(todoos add "${words[@]:1}")
  ((CURRENT++))
  _todoos
}

_no_completion() {
  return 1
}

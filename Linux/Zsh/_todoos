#compdef todoos

_todoos() {
    local current_word
    current_word="${words[CURRENT]}"

    # Check if the current word is quoted
    if [[ $current_word == *"'"* || $current_word == *'"'* ]]; then
        return
    fi

    # The words typed so far, given to todoos as separate arguments: no eval, so nothing
    # typed (e.g. $(...)) is executed by the completion. (Q) only removes the quoting.
    # The current word is given too (when not empty), so todoos knows e.g. an option name is being typed.
    local -a args
    args=("${(@Q)words[2,CURRENT-1]}")
    [[ -n $current_word ]] && args+=("${(Q)current_word}")

    local completion_output
    completion_output=($(todoos commands "${args[@]}" | sed 's/\\ /--TEMP_SPACE_AUTOCOMPLETE--/g' | tr ' ' '\n'))

    # If '_file' is returned, use file completion
    if [[ " ${completion_output[*]} " == *" _file "* ]]; then
        _files
        return
    fi

    local words_to_add=()
    for word in "${completion_output[@]}"; do
        words_to_add+=("${word//--TEMP_SPACE_AUTOCOMPLETE--/ }")
    done

    compadd -Q -- "${words_to_add[@]}"
}

_todoos "$@"
